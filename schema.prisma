  clawedBackAt DateTime?
  agent        User?     @relation("Commission_agent", fields: [agentId], references: [id])
  agentId      String?   @map("agent")
  order        Order?    @relation("Commission_order", fields: [orderId], references: [id])
  orderId      String?   @map("order")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([status])
  @@index([agentId])
  @@index([orderId])
}

model CommissionRule {
  id        String   @id @default(cuid())
  name      String   @default("")
  type      String   @default("percent_of_order")
  value     String   @default("0")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Story {
  id           String   @id @default(cuid())
  title        String   @default("")
  slug         String   @unique @default("")
  customerName String   @default("")
  location     String   @default("")
  body         String   @default("")
  imageUrl     String   @default("")
  savingsText  String   @default("")
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model Faq {
  id          String   @id @default(cuid())
  question    String   @default("")
  answer      String   @default("")
  category    String   @default("general")
  sortOrder   Int?     @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model OAuthApp {
  id                      String   @id @default(cuid())
  name                    String   @default("")
  clientId                String   @unique @default("")
  clientSecret            String   @default("")
  tokenEndpointAuthMethod String?  @default("client_secret_post")
  redirectUris            Json?    @default("[]")
  scopes                  Json?    @default("[\"mcp:read\",\"mcp:write\"]")
  webhookUrl              String   @default("")
  status                  String?  @default("active")
  installUrl              String   @default("")
  uninstallUrl            String   @default("")
  description             String   @default("")
  metadata                Json?    @default("{}")
  developerEmail          String   @default("")
  privacyPolicyUrl        String   @default("")
  termsOfServiceUrl       String   @default("")
  supportUrl              String   @default("")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @default(now()) @updatedAt
}

model OAuthToken {
  id                  String    @id @default(cuid())
  tokenType           String
  token               String    @unique @default("")
  clientId            String    @default("")
  user                User?     @relation("OAuthToken_user", fields: [userId], references: [id])
  userId              String?   @map("user")
  scopes              Json?     @default("[]")
  redirectUri         String    @default("")
  resource            String    @default("")
  expiresAt           DateTime?
  isRevoked           String?   @default("false")
  authorizationCode   String    @default("")
  refreshToken        String    @default("")
  accessToken         String    @default("")
  state               String    @default("")
  codeChallenge       String    @default("")
  codeChallengeMethod String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  @@index([clientId])
  @@index([userId])
}
