  from_AuditEvent_actor          AuditEvent[]        @relation("AuditEvent_actor")
  from_ContactLog_user           ContactLog[]        @relation("ContactLog_user")
  from_Media_uploadedBy          Media[]             @relation("Media_uploadedBy")
  from_StockMovement_user        StockMovement[]     @relation("StockMovement_user")
  from_LeadActivity_user         LeadActivity[]      @relation("LeadActivity_user")
  from_Quote_preparedBy          Quote[]             @relation("Quote_preparedBy")
  from_Quote_approvedBy          Quote[]             @relation("Quote_approvedBy")
  from_Cart_createdBy            Cart[]              @relation("Cart_createdBy")
  from_Order_salesAgent          Order[]             @relation("Order_salesAgent")
